APP_ENV=development
BACKEND_PORT=8080
BACKEND_HOST_PORT=18080
FRONTEND_PORT=3000
AI_SERVICE_PORT=8001
VIDEO_ENGINE_PORT=8002
BACKEND_API_URL=http://backend:8080
AI_SERVICE_URL=http://ai-service:8001
VIDEO_ENGINE_URL=http://video-engine:8002

POSTGRES_DB=aihuman
POSTGRES_USER=aihuman
POSTGRES_PASSWORD=aihuman_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=15432
DATABASE_URL=postgres://aihuman:aihuman_dev_password@postgres:5432/aihuman?sslmode=disable

REDIS_ADDR=redis:6379
REDIS_STREAM=video_tasks
WORKER_ENABLED=true
REDIS_HOST_PORT=16379
QDRANT_URL=http://qdrant:6333
QDRANT_HOST_PORT=16333

MINIO_ROOT_USER=aihuman
MINIO_ROOT_PASSWORD=aihuman_dev_password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=aihuman-assets
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
OSS_ENDPOINT=http://minio:9000
OSS_PUBLIC_URL=http://localhost:19000
OSS_BUCKET=aihuman-assets
OSS_ACCESS_KEY=aihuman
OSS_SECRET_KEY=aihuman_dev_password
